---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogIndex from '../../components/BlogIndex.astro';
import { getPosts, totalBlogPages, pageSlice } from '../../utils/blog';

const allPosts = await getPosts('fr');
const totalPages = totalBlogPages(allPosts.length);
const posts = pageSlice(allPosts, 1);
---

<BaseLayout
  title="Blog DIGABLO : digital, logiciels & marketing"
  description="Conseils et analyses sur le développement logiciel, les applications, le marketing digital et la transformation numérique des entreprises."
>
  <BlogIndex
    lang="fr"
    posts={posts}
    currentPage={1}
    totalPages={totalPages}
    heading="Le blog DIGABLO"
    intro="Stratégie, développement, marketing digital et retours d’expérience pour faire grandir votre entreprise."
  />
</BaseLayout>
