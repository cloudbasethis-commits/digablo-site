---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import AuthorPage from '../../../../components/AuthorPage.astro';
import { authors } from '../../../../data/authors';

export function getStaticPaths() {
  return authors.map((author) => ({ params: { id: author.id }, props: { author } }));
}

const { author } = Astro.props;
---

<BaseLayout
  title={`${author.name}, ${author.role.en} | DIGABLO`}
  description={author.bio.en.slice(0, 155)}
  alternates={{ fr: `/blog/auteur/${author.id}`, en: `/en/blog/author/${author.id}` }}
>
  <AuthorPage author={author} lang="en" />
</BaseLayout>
