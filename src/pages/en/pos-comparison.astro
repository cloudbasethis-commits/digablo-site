---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import { comparisonPage, solutions, criteria, lastChecked } from '../../data/comparison';

const c = comparisonPage.en;
const SITE = 'https://digablo.fr';
const canonical = `${SITE}/en/pos-comparison/`;

/** ItemList de SoftwareApplication : format que les moteurs IA citent volontiers. */
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${canonical}#comparison`,
  name: c.heading,
  description: c.description,
  inLanguage: 'en',
  numberOfItems: solutions.length,
  itemListElement: solutions.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: s.name,
      url: s.url,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web, Android, iOS',
      description: criteria.map((crit) => `${crit.label.en}: ${s.cells[crit.key]?.en}`).join('. '),
    },
  })),
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  inLanguage: 'en',
  mainEntity: c.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const datasetJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': `${canonical}#dataset`,
  name: c.heading,
  description: c.description,
  dateModified: lastChecked,
  creator: { '@type': 'Organization', name: 'DIGABLO', url: SITE },
  license: `${SITE}/en/pos-comparison/`,
};
---

<BaseLayout
  title={`${c.title} | DIGABLO`}
  description={c.description}
  alternates={{ fr: '/comparateur', en: '/en/pos-comparison' }}
>
  <ComparisonTable lang="en" />

  <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(datasetJsonLd)} is:inline />
</BaseLayout>
