---
import type { Lang } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import { solutions, criteria, comparisonPage, lastChecked } from '../data/comparison';
import { formatDate } from '../utils/blog';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = comparisonPage[lang];
const checked = formatDate(new Date(lastChecked), lang);

const toneClass = (tone?: string) =>
  tone === 'yes'
    ? 'text-teal-700'
    : tone === 'no'
      ? 'text-ink-400'
      : tone === 'partial'
        ? 'text-ink-700'
        : 'text-ink-600';
---

<section class="bg-white py-16 lg:py-20">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <header class="max-w-3xl">
      <p class="text-sm font-semibold tracking-wide text-brand-600 uppercase">
        {lang === 'fr' ? 'Comparateur' : 'Comparison'}
      </p>
      <h1 class="mt-3 text-4xl font-bold text-ink-950 sm:text-5xl">{c.heading}</h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-500">{c.intro}</p>
      <p class="mt-4 text-sm text-ink-500">{c.updated} {checked}</p>
    </header>

    <!-- Le tableau défile horizontalement plutôt que de faire déborder la page. -->
    <div class="mt-12 overflow-x-auto">
      <table class="w-full min-w-[52rem] border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-ink-200">
            <th scope="col" class="w-44 py-4 pr-4 align-bottom font-semibold text-ink-500">
              {lang === 'fr' ? 'Critère' : 'Criterion'}
            </th>
            {
              solutions.map((s) => (
                <th
                  scope="col"
                  class={`px-4 py-4 align-bottom ${s.own ? 'bg-brand-50/60' : ''}`}
                >
                  <a href={s.url} target="_blank" rel="noopener" class="text-base font-bold text-ink-950 hover:text-brand-600">
                    {s.name}
                  </a>
                  <span class="mt-1 block text-xs font-normal text-ink-500">{s.editor[lang]}</span>
                  {s.own && (
                    <span class="mt-2 inline-block rounded-full bg-brand-600 px-2 py-0.5 text-[11px] font-semibold text-white">
                      {c.ownBadge}
                    </span>
                  )}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            criteria.map((crit) => (
              <tr class="border-b border-ink-100 align-top">
                <th scope="row" class="py-4 pr-4 font-semibold text-ink-900">{crit.label[lang]}</th>
                {solutions.map((s) => {
                  const cell = s.cells[crit.key];
                  return (
                    <td class={`px-4 py-4 leading-relaxed ${s.own ? 'bg-brand-50/60' : ''} ${toneClass(cell?.tone)}`}>
                      {cell?.[lang]}
                      {cell?.source && (
                        <a
                          href={cell.source}
                          target="_blank"
                          rel="noopener nofollow"
                          class="ml-1 whitespace-nowrap text-xs font-medium text-brand-600 hover:underline"
                        >
                          ({c.sourceLabel})
                        </a>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="mt-10 rounded-2xl border border-ink-100 bg-ink-50/50 p-6">
      <h2 class="font-semibold text-ink-950">{c.method.heading}</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-600">{c.method.body}</p>
    </div>

    <section class="mt-14" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-2xl font-bold text-ink-950">
        {lang === 'fr' ? 'Questions fréquentes' : 'Frequently asked questions'}
      </h2>
      <dl class="mt-6 divide-y divide-ink-100 border-t border-ink-100">
        {c.faq.map((item) => (
          <div class="py-5">
            <dt class="font-semibold text-ink-950">{item.question}</dt>
            <dd class="mt-2 leading-relaxed text-ink-600">{item.answer}</dd>
          </div>
        ))}
      </dl>
    </section>

    <div class="mt-12 rounded-2xl bg-ink-950 p-8 text-white">
      <h2 class="text-xl font-bold">{c.ctaHeading}</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-ink-300">{c.ctaText}</p>
      <a
        href={`${localizePath('/', lang)}#contact`}
        class="mt-6 inline-block rounded-xl bg-brand-600 px-6 py-3 font-semibold text-white transition hover:bg-brand-500"
      >
        {c.ctaButton}
      </a>
    </div>
  </div>
</section>
