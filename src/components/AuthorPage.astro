---
import type { Author } from '../data/authors';
import type { Lang } from '../i18n/ui';
import { useTranslations, localizePath } from '../i18n/utils';
import { getPosts, postSlug, readingTime, formatDate } from '../utils/blog';

interface Props {
  author: Author;
  lang: Lang;
}
const { author, lang } = Astro.props;
const t = useTranslations(lang);
const posts = (await getPosts(lang)).filter((p) => p.data.author === author.id);

const SITE = 'https://digablo.fr';
const withTrailingSlash = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const canonical = new URL(withTrailingSlash(Astro.url.pathname), SITE).href;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${canonical}#profile`,
  url: canonical,
  inLanguage: lang === 'fr' ? 'fr-FR' : 'en',
  mainEntity: {
    '@type': author.person ? 'Person' : 'Organization',
    '@id': `${canonical}#person`,
    name: author.name,
    url: canonical,
    description: author.bio[lang],
    ...(author.role[lang] ? { jobTitle: author.role[lang] } : {}),
    ...(author.sameAs?.length ? { sameAs: author.sameAs } : {}),
    worksFor: { '@type': 'Organization', name: 'DIGABLO', url: SITE },
  },
};
---

<section class="bg-white py-16 lg:py-20">
  <div class="mx-auto max-w-3xl px-5 lg:px-8">
    <a href={localizePath('/blog', lang)} class="text-sm font-medium text-brand-600 hover:text-brand-700">
      {t('common.backToBlog')}
    </a>

    <header class="mt-8 flex items-start gap-5">
      <span
        class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-ink-950 text-lg font-bold text-white"
        aria-hidden="true"
      >
        {author.name.split(' ').slice(0, 2).map((w) => w[0]).join('')}
      </span>
      <div>
        <h1 class="text-3xl font-bold text-ink-950 sm:text-4xl">{author.name}</h1>
        <p class="mt-1 text-ink-500">{author.role[lang]}</p>
      </div>
    </header>

    <p class="mt-6 text-lg leading-relaxed text-ink-600">{author.bio[lang]}</p>

    <h2 class="mt-14 text-xl font-bold text-ink-950">
      {t('common.articlesBy')} {author.name}
    </h2>

    {
      posts.length === 0 ? (
        <p class="mt-4 text-ink-500">
          {lang === 'fr' ? 'Aucun article pour le moment.' : 'No articles yet.'}
        </p>
      ) : (
        <ul class="mt-6 divide-y divide-ink-100 border-t border-ink-100">
          {posts.map((post) => (
            <li class="py-5">
              <a href={localizePath(`/blog/${postSlug(post.id)}`, lang)} class="group block">
                <h3 class="text-lg font-semibold text-ink-900 group-hover:text-brand-600">{post.data.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-ink-500">{post.data.description}</p>
                <p class="mt-2 text-xs text-ink-500">
                  {formatDate(post.data.pubDate, lang)} · {readingTime(post.body)} {t('common.minRead')}
                </p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} is:inline />
