---
import type { Lang } from '../i18n/ui';
import { useTranslations, localizePath } from '../i18n/utils';
import { getPosts, postSlug, readingTime, formatDate } from '../utils/blog';

interface Props {
  lang: Lang;
  eyebrow: string;
  heading: string;
  subheading: string;
  /** Nombre d'articles affichés (les plus récents). */
  limit?: number;
}
const { lang, eyebrow, heading, subheading, limit = 3 } = Astro.props;
const t = useTranslations(lang);
const posts = (await getPosts(lang)).slice(0, limit);
---

{
  posts.length > 0 && (
    <section id="blog" class="bg-white py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div class="max-w-2xl">
            <p class="text-sm font-semibold tracking-wide text-brand-600 uppercase">{eyebrow}</p>
            <h2 class="mt-3 text-3xl font-bold text-ink-950 sm:text-4xl">{heading}</h2>
            <p class="mt-4 text-lg text-ink-500">{subheading}</p>
          </div>
          <a
            href={localizePath('/blog', lang)}
            class="inline-flex items-center gap-1.5 font-semibold text-brand-600 hover:text-brand-700"
          >
            {t('common.allPosts')}
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <a
              href={localizePath(`/blog/${postSlug(post.id)}`, lang)}
              class="group flex flex-col rounded-2xl border border-ink-100 bg-ink-50/40 p-6 transition hover:border-brand-200 hover:bg-white hover:shadow-xl hover:shadow-ink-900/5"
            >
              <div class="flex flex-wrap gap-2">
                {post.data.tags.slice(0, 2).map((tag) => (
                  <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700">{tag}</span>
                ))}
              </div>
              <h3 class="mt-3 text-lg font-semibold text-ink-900 group-hover:text-brand-600">
                {post.data.title}
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">{post.data.description}</p>
              <p class="mt-4 text-xs text-ink-500">
                {formatDate(post.data.pubDate, lang)} · {readingTime(post.body)} {t('common.minRead')}
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
