---
import BaseLayout from './BaseLayout.astro';
import type { Post } from '../utils/blog';
import { readingTime, formatDate } from '../utils/blog';
import { useTranslations, localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { resolveAuthor, authorPath } from '../data/authors';
import { postSlug } from '../utils/blog';

interface Props {
  post: Post;
  lang: Lang;
}
const { post, lang } = Astro.props;
const t = useTranslations(lang);
const { title, description, pubDate, updatedDate, author, tags, cover, faq, altSlug } = post.data;
const coverSrc = cover ? (typeof cover === 'string' ? cover : cover.src) : undefined;
const writer = resolveAuthor(author);
const writerPath = authorPath(writer, lang);

const SITE = 'https://digablo.fr';
/** Même convention de « / » final que la canonique et le sitemap. */
const withTrailingSlash = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const canonical = new URL(withTrailingSlash(Astro.url.pathname), SITE).href;
/** Image de l'article : couverture si présente, sinon visuel OG de marque (1200x630). */
const articleImage = new URL(coverSrc ?? '/brand/og-default.png', SITE).href;
const published = pubDate.toISOString();
const modified = (updatedDate ?? pubDate).toISOString();
const blogUrl = new URL(withTrailingSlash(localizePath('/blog', lang)), SITE).href;
const writerUrl = writerPath ? new URL(withTrailingSlash(writerPath), SITE).href : SITE;

/**
 * hreflang : seulement si l'article a un équivalent déclaré dans l'autre langue.
 * `altSlug` porte le slug de cet équivalent, les deux versions étant rédigées
 * séparément et n'ayant donc pas forcément le même slug.
 */
const slug = postSlug(post.id);
const alternates = altSlug
  ? lang === 'fr'
    ? { fr: `/blog/${slug}`, en: `/en/blog/${altSlug}` }
    : { fr: `/blog/${altSlug}`, en: `/en/blog/${slug}` }
  : null;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${canonical}#article`,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  url: canonical,
  headline: title,
  description,
  image: articleImage,
  inLanguage: lang === 'fr' ? 'fr-FR' : 'en',
  datePublished: published,
  dateModified: modified,
  keywords: tags.join(', '),
  wordCount: post.body?.trim().split(/\s+/).length,
  author: {
    '@type': writer.person ? 'Person' : 'Organization',
    name: writer.name,
    url: writerUrl,
    ...(writer.role[lang] ? { jobTitle: writer.role[lang] } : {}),
    ...(writer.sameAs?.length ? { sameAs: writer.sameAs } : {}),
  },
  publisher: {
    '@type': 'Organization',
    name: 'DIGABLO',
    url: SITE,
    logo: { '@type': 'ImageObject', url: `${SITE}/brand/digablo-logo-dark.png` },
  },
  isPartOf: { '@type': 'Blog', '@id': `${blogUrl}#blog`, name: 'DIGABLO', url: blogUrl },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('common.home'), item: new URL(localizePath('/', lang), SITE).href },
    { '@type': 'ListItem', position: 2, name: t('nav.blog'), item: blogUrl },
    { '@type': 'ListItem', position: 3, name: title, item: canonical },
  ],
};

/** FAQPage : uniquement si les Q/R sont réellement affichées sur la page. */
const faqJsonLd = faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      inLanguage: lang === 'fr' ? 'fr-FR' : 'en',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;
---

<BaseLayout
  title={`${title} — DIGABLO`}
  description={description}
  type="article"
  image={coverSrc}
  publishedTime={published}
  modifiedTime={modified}
  tags={tags}
  alternates={alternates}
>
  <article class="bg-white py-16 lg:py-20">
    <div class="mx-auto max-w-3xl px-5 lg:px-8">
      <a href={localizePath('/blog', lang)} class="text-sm font-medium text-brand-600 hover:text-brand-700">
        {t('common.backToBlog')}
      </a>

      <header class="mt-6">
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700">{tag}</span>)}
        </div>
        <h1 class="mt-4 text-3xl font-bold leading-tight text-ink-950 sm:text-4xl">{title}</h1>
        <p class="mt-4 text-sm text-ink-500">
          <time datetime={published}>{t('common.published')} {formatDate(pubDate, lang)}</time>
          {updatedDate && (
            <> · <time datetime={modified}>{t('common.updated')} {formatDate(updatedDate, lang)}</time></>
          )}
          {' '}· {readingTime(post.body)} {t('common.minRead')}
        </p>
        <p class="mt-2 text-sm text-ink-600">
          {t('common.by')}{' '}
          {writerPath ? (
            <a href={writerPath} class="font-semibold text-ink-900 hover:text-brand-600">{writer.name}</a>
          ) : (
            <span class="font-semibold text-ink-900">{writer.name}</span>
          )}
          {writer.role[lang] && <span class="text-ink-500">, {writer.role[lang]}</span>}
        </p>
      </header>

      {
        coverSrc && (
          <img src={coverSrc} alt={title} class="mt-8 aspect-[16/9] w-full rounded-2xl object-cover" />
        )
      }

      <div class="article-body mt-10">
        <slot />
      </div>

      {
        faq && faq.length > 0 && (
          <section class="mt-14" aria-labelledby="faq-heading">
            <h2 id="faq-heading" class="text-2xl font-bold text-ink-950">{t('common.faq')}</h2>
            <dl class="mt-6 divide-y divide-ink-100 border-t border-ink-100">
              {faq.map((item) => (
                <div class="py-5">
                  <dt class="font-semibold text-ink-950">{item.question}</dt>
                  <dd class="mt-2 text-ink-600">{item.answer}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      {
        writer.bio[lang] && (
          <aside class="mt-14 rounded-2xl border border-ink-100 bg-ink-50/50 p-6 sm:p-7">
            <div class="flex items-start gap-4">
              <span
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-ink-950 text-sm font-bold text-white"
                aria-hidden="true"
              >
                {writer.name
                  .split(' ')
                  .slice(0, 2)
                  .map((w) => w[0])
                  .join('')}
              </span>
              <div>
                <p class="text-xs font-semibold tracking-wide text-brand-600 uppercase">{t('common.aboutAuthor')}</p>
                <p class="mt-1 font-semibold text-ink-950">
                  {writer.name}
                  {writer.role[lang] && <span class="font-normal text-ink-500">, {writer.role[lang]}</span>}
                </p>
                <p class="mt-2 text-sm leading-relaxed text-ink-600">{writer.bio[lang]}</p>
                {writerPath && (
                  <a href={writerPath} class="mt-3 inline-block text-sm font-semibold text-brand-600 hover:text-brand-700">
                    {t('common.authorPosts')} →
                  </a>
                )}
              </div>
            </div>
          </aside>
        )
      }

      <hr class="mt-12 border-ink-100" />
      <div class="mt-8 rounded-2xl bg-ink-950 p-8 text-center text-white">
        <h2 class="text-xl font-bold">{t('common.talk')}</h2>
        <a
          href={`${localizePath('/', lang)}#contact`}
          class="mt-5 inline-block rounded-xl bg-brand-600 px-6 py-3 font-semibold text-white transition hover:bg-brand-500"
        >
          {t('nav.cta')}
        </a>
      </div>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} is:inline />
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />}
</BaseLayout>
