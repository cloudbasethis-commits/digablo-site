---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, alternatePath } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  /** Image OpenGraph (chemin absolu depuis /public). */
  image?: string;
  /** Type de page pour OpenGraph. */
  type?: 'website' | 'article';
  /** Empêcher l'indexation (pages utilitaires). */
  noindex?: boolean;
  /**
   * Override des URL alternées (hreflang) quand les slugs diffèrent par langue.
   * `null` = la page n'a pas d'équivalent dans l'autre langue : aucune balise
   * alternate n'est émise (pointer vers une page inexistante fait plus de mal
   * que de ne rien déclarer).
   */
  alternates?: { fr: string; en: string } | null;
  /** Dates ISO pour les balises OpenGraph d'article. */
  publishedTime?: string;
  modifiedTime?: string;
  /** Mots-clés de l'article (article:tag). */
  tags?: string[];
}

const {
  title,
  description,
  image = '/brand/og-default.png',
  type = 'website',
  noindex = false,
  alternates,
  publishedTime,
  modifiedTime,
  tags = [],
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const ogLocale = lang === 'fr' ? 'fr_FR' : 'en_US';

/** Les URL générées se terminent par « / » : les hreflang doivent suivre la même
 *  convention que la canonique, sinon Google signale une incohérence. */
const withTrailingSlash = (path: string) => (path.endsWith('/') ? path : `${path}/`);

const canonical = new URL(withTrailingSlash(Astro.url.pathname), Astro.site).href;
const hasAlternates = alternates !== null;
const frUrl = new URL(withTrailingSlash(alternates ? alternates.fr : alternatePath(Astro.url.pathname, 'fr')), Astro.site).href;
const enUrl = new URL(withTrailingSlash(alternates ? alternates.en : alternatePath(Astro.url.pathname, 'en')), Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'DIGABLO',
  url: 'https://digablo.fr',
  logo: 'https://digablo.fr/brand/digablo-logo-dark.png',
  description:
    "Agence digitale internationale : logiciels sur mesure, applications web et mobiles, sites web et marketing digital.",
  email: 'contact@digablo.fr',
  telephone: '+33783813956',
  address: [
    {
      '@type': 'PostalAddress',
      streetAddress: '32 rue Félicien Rops',
      postalCode: '91100',
      addressLocality: 'Corbeil-Essonnes',
      addressCountry: 'FR',
    },
    {
      '@type': 'PostalAddress',
      streetAddress: 'Avenue Marinelle n° 8 Bis, C/Gombé',
      addressLocality: 'Kinshasa',
      addressCountry: 'CD',
    },
  ],
  contactPoint: [
    { '@type': 'ContactPoint', telephone: '+33783813956', contactType: 'customer service', areaServed: 'FR' },
    { '@type': 'ContactPoint', telephone: '+243858869656', contactType: 'customer service', areaServed: 'CD' },
  ],
  sameAs: ['https://pos.digablo.fr'],
  makesOffer: {
    '@type': 'Offer',
    itemOffered: {
      '@type': 'SoftwareApplication',
      name: 'digabloPos',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web, Android, iOS, Windows',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    },
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <!-- Alternances de langue (hreflang) -->
    {
      hasAlternates && (
        <>
          <link rel="alternate" hreflang="fr-FR" href={frUrl} />
          <link rel="alternate" hreflang="en" href={enUrl} />
          <link rel="alternate" hreflang="x-default" href={frUrl} />
        </>
      )
    }

    <!-- OpenGraph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="DIGABLO" />
    {/* Dimensions connues uniquement pour l'image OG par défaut (1200x630). */}
    {image === '/brand/og-default.png' && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:image:alt" content={title} />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === 'article' && <meta property="article:publisher" content="https://digablo.fr" />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0b0e13" />
    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} is:inline />
  </head>
  <body class="antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white"
    >
      Aller au contenu
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <!-- Vercel Web Analytics (sans cookie, RGPD-friendly) — actif une fois "Analytics" activé dans Vercel -->
    <script is:inline defer src="/_vercel/insights/script.js"></script>
  </body>
</html>
